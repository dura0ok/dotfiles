#!/usr/bin/env bash
# Lock niri with gtklock (real password entry on every output).
set -euo pipefail

cfg=${XDG_CONFIG_HOME:-$HOME/.config}/gtklock
bg=
if command -v niri-wallpaper >/dev/null; then
  bg=$(niri-wallpaper path 2>/dev/null || true)
fi

if command -v gtklock >/dev/null; then
  args=(-d)
  [[ -f $cfg/config.ini ]] && args+=(-c "$cfg/config.ini")
  [[ -f $cfg/style.css ]] && args+=(-s "$cfg/style.css")
  [[ -n ${bg:-} && -f $bg ]] && args+=(-b "$bg")
  exec gtklock "${args[@]}"
fi

echo "niri-lock: install gtklock (sudo dnf install -y gtklock)" >&2
exec swaylock -f
