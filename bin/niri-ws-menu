#!/usr/bin/env bash
# Named workspaces + presets from ~/.config/niri/ws-presets.kdl
set -euo pipefail

FUZZEL=(fuzzel --dmenu --width 52 --lines 16 --no-icons)
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/niri"
WORKSPACES="$CONFIG_DIR/workspaces.kdl"
PRESETS="$CONFIG_DIR/ws-presets.kdl"

notify() {
  command -v notify-send >/dev/null && notify-send -a niri-ws "Workspaces" "$1" || true
}

workspaces_json() {
  niri msg --json workspaces
}

expand_path() {
  local p=$1
  if [[ $p == ~* ]]; then
    p="${p/#\~/$HOME}"
  fi
  printf '%s\n' "$p"
}

# List preset names from ws-presets.kdl
list_presets() {
  [[ -f $PRESETS ]] || return 0
  sed -nE 's/^[[:space:]]*preset[[:space:]]+"([^"]+)".*/\1/p' "$PRESETS"
}

# Extract body of preset "name" { ... } (non-nested)
preset_body() {
  local name=$1
  [[ -f $PRESETS ]] || return 1
  awk -v want="$name" '
    $0 ~ "^[[:space:]]*preset[[:space:]]+\"" want "\"" {
      grab=1
      next
    }
    grab {
      if ($0 ~ /^[[:space:]]*}/) exit
      print
    }
  ' "$PRESETS"
}

preset_cwd() {
  local name=$1 line
  while IFS= read -r line; do
    if [[ $line =~ ^[[:space:]]*cwd[[:space:]]+\"([^\"]+)\" ]]; then
      expand_path "${BASH_REMATCH[1]}"
      return 0
    fi
  done < <(preset_body "$name")
  return 1
}

preset_layout() {
  local name=$1 line
  while IFS= read -r line; do
    if [[ $line =~ ^[[:space:]]*layout[[:space:]]+\"([^\"]+)\" ]]; then
      printf '%s\n' "${BASH_REMATCH[1]}"
      return 0
    fi
  done < <(preset_body "$name")
  printf 'default\n'
}

# Print spawn lines as NUL-separated argv arrays encoded: cmd\targ\targ\n
preset_spawns() {
  local name=$1 cwd="" line
  cwd=$(preset_cwd "$name" || true)

  while IFS= read -r line; do
    [[ $line =~ ^[[:space:]]*spawn[[:space:]] ]] || continue
    # collect "..." tokens
    local -a args=()
    local rest=$line
    while [[ $rest =~ \"([^\"]*)\"(.*) ]]; do
      args+=("${BASH_REMATCH[1]}")
      rest=${BASH_REMATCH[2]}
    done
    ((${#args[@]} > 0)) || continue

    if [[ -n $cwd ]]; then
      case ${args[0]} in
        ghostty|kitty|alacritty|wezterm|foot)
          local has_wd=0 a
          for a in "${args[@]}"; do
            [[ $a == --working-directory=* || $a == -d ]] && has_wd=1
          done
          ((has_wd)) || args+=("--working-directory=$cwd")
          ;;
        code|code-insiders|cursor|codium)
          # folder path usually last; add if none looks like a path
          local has_path=0 a
          for a in "${args[@]:1}"; do
            [[ $a == -* ]] && continue
            has_path=1
          done
          ((has_path)) || args+=("$cwd")
          ;;
        emacs|nvim|vim|helix|zed)
          ((${#args[@]} == 1)) && args+=("$cwd")
          ;;
      esac
    fi

    local i
    printf '%s' "${args[0]}"
    for ((i = 1; i < ${#args[@]}; i++)); do
      printf '\t%s' "${args[i]}"
    done
    printf '\n'
  done < <(preset_body "$name")
}

persist_workspace() {
  local name=$1
  mkdir -p "$CONFIG_DIR"
  touch "$WORKSPACES"
  if grep -qE "^workspace \"$name\"( |\$|\{)" "$WORKSPACES"; then
    return 0
  fi
  printf 'workspace "%s"\n' "$name" >>"$WORKSPACES"
}

unpersist_workspace() {
  local name=$1
  [[ -f $WORKSPACES ]] || return 0
  sed -i -E "/^workspace \"$name\"( |\$|\{)/d" "$WORKSPACES"
}

focus_empty_unnamed() {
  local idx
  idx=$(workspaces_json | jq -r '
    [.[] | select(.name == null and .active_window_id == null)]
    | last
    | .idx // empty
  ')
  if [[ -n ${idx:-} ]]; then
    niri msg action focus-workspace "$idx"
    return 0
  fi
  idx=$(workspaces_json | jq -r '
    [.[] | select(.is_focused or .is_active)] | first | .output as $o
    | [.[] | select(.output == $o)] | last | .idx
  ')
  niri msg action focus-workspace "$idx"
}

ensure_named_workspace() {
  local name=$1 exists
  exists=$(workspaces_json | jq -r --arg n "$name" '.[] | select(.name == $n) | .name' | head -n1)
  if [[ -z ${exists:-} ]]; then
    focus_empty_unnamed
    niri msg action set-workspace-name "$name"
  fi
  persist_workspace "$name"
  niri msg action focus-workspace "$name"
}

workspace_id_by_name() {
  local name=$1
  workspaces_json | jq -r --arg n "$name" '.[] | select(.name == $n) | .id' | head -n1
}

# Wait until $count tiling windows exist on workspace id $1 (timeout ~seconds)
wait_workspace_windows() {
  local ws_id=$1 need=${2:-2} tries=${3:-40} n
  while ((tries-- > 0)); do
    n=$(niri msg --json windows | jq -r --argjson id "$ws_id" '
      [.[] | select(.workspace_id == $id and (.is_floating | not))] | length
    ')
    ((n >= need)) && return 0
    sleep 0.25
  done
  return 1
}

# Side-by-side: editor left, terminal right, each ~50%.
arrange_split() {
  local ws_name=$1
  local ws_id left right

  ws_id=$(workspace_id_by_name "$ws_name")
  [[ -n ${ws_id:-} ]] || return 1
  wait_workspace_windows "$ws_id" 2 48 || true

  # Unstack until every column has a single window
  local guard=8 stacked
  while ((guard-- > 0)); do
    stacked=$(niri msg --json windows | jq -r --argjson id "$ws_id" '
      [.[] | select(.workspace_id == $id and (.is_floating | not))
        | .layout.pos_in_scrolling_layout[0]]
      | group_by(.) | map(select(length > 1)) | length
    ')
    ((stacked > 0)) || break
    niri msg action focus-workspace "$ws_name"
    niri msg action expel-window-from-column || true
    sleep 0.05
  done

  read -r left right < <(niri msg --json windows | jq -r --argjson id "$ws_id" '
    def score:
      (.app_id // "") as $a |
      if ($a | test("(?i)code|cursor|codium|emacs|zed")) then 0
      elif ($a | test("(?i)ghostty|kitty|alacritty|wezterm|foot|terminal")) then 2
      else 1 end;
    [.[] | select(.workspace_id == $id and (.is_floating | not))]
    | sort_by(score, .id)
    | "\(.[0].id // "") \(.[1].id // "")"
  ')

  [[ -n ${left:-} && -n ${right:-} && $left != "$right" ]] || return 1

  niri msg action focus-window --id "$left"
  niri msg action move-column-to-index 1
  niri msg action set-column-width "50%"

  niri msg action focus-window --id "$right"
  niri msg action move-column-to-index 2
  niri msg action set-column-width "50%"

  niri msg action focus-window --id "$left"
}

launch_preset_apps() {
  local name=$1 layout=${2:-default} line
  local -a args lines=()
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    lines+=("$line")
  done < <(preset_spawns "$name")

  local i=0
  for line in "${lines[@]}"; do
    # For split: pause after the first app so columns form side-by-side.
    if [[ $layout == split && $i -eq 1 ]]; then
      sleep 0.6
    fi
    IFS=$'\t' read -r -a args <<<"$line"
    "${args[@]}" &
    ((++i))
  done
}

preset_is_open() {
  local name=$1 cwd ws_id
  if workspaces_json | jq -e --arg n "$name" 'any(.name == $n)' >/dev/null; then
    return 0
  fi
  cwd=$(preset_cwd "$name" || true)
  [[ -n ${cwd:-} ]] || return 1
  ws_id=$(niri msg --json windows | jq -r --arg cwd "$cwd" --arg base "$(basename "$cwd")" '
    [.[] | select(
      (.title // "" | contains($cwd))
      or (.title // "" | contains($base))
    )] | first | .workspace_id // empty
  ')
  [[ -n ${ws_id:-} ]]
}

create_from_preset() {
  local name=$1 layout
  layout=$(preset_layout "$name")
  if preset_is_open "$name"; then
    # already running — just focus, don't spawn again
    if workspaces_json | jq -e --arg n "$name" 'any(.name == $n)' >/dev/null; then
      niri msg action focus-workspace "$name"
      if [[ $layout == split ]]; then
        arrange_split "$name" || true
      fi
    else
      local cwd wid
      cwd=$(preset_cwd "$name")
      wid=$(niri msg --json windows | jq -r --arg cwd "$cwd" --arg base "$(basename "$cwd")" '
        [.[] | select(
          (.title // "" | contains($cwd))
          or (.title // "" | contains($base))
        )] | first | .id // empty
      ')
      [[ -n ${wid:-} ]] && niri msg action focus-window --id "$wid"
    fi
    notify "Focus «$name»"
    return 0
  fi
  ensure_named_workspace "$name"
  sleep 0.05
  launch_preset_apps "$name" "$layout"
  if [[ $layout == split ]]; then
    arrange_split "$name" || true
  fi
  notify "Preset «$name»"
}

close_windows_on_workspace() {
  local ws_id=$1 wid
  while true; do
    wid=$(niri msg --json windows | jq -r --argjson id "$ws_id" '
      [.[] | select(.workspace_id == $id)] | first | .id // empty
    ')
    [[ -n ${wid:-} ]] || break
    niri msg action close-window --id "$wid" || break
    sleep 0.05
  done
}

delete_workspace_by_name() {
  local name=$1
  local ws_id cwd other_idx
  ws_id=$(workspaces_json | jq -r --arg n "$name" '
    .[] | select(.name == $n) | .id
  ' | head -n1)

  if [[ -z ${ws_id:-} ]]; then
    cwd=$(preset_cwd "$name" || true)
    if [[ -n ${cwd:-} ]]; then
      ws_id=$(niri msg --json windows | jq -r --arg cwd "$cwd" --arg base "$(basename "$cwd")" '
        [.[] | select(
          (.title // "" | contains($cwd))
          or (.title // "" | contains($base))
        )] | first | .workspace_id // empty
      ')
    fi
  fi

  if [[ -n ${ws_id:-} ]]; then
    local wid
    wid=$(niri msg --json windows | jq -r --argjson id "$ws_id" '
      [.[] | select(.workspace_id == $id)] | first | .id // empty
    ')
    if [[ -n ${wid:-} ]]; then
      niri msg action focus-window --id "$wid"
    elif [[ -n $name ]]; then
      niri msg action focus-workspace "$name" || true
    fi
    close_windows_on_workspace "$ws_id"
    if workspaces_json | jq -e --arg n "$name" 'any(.name == $n)' >/dev/null; then
      niri msg action unset-workspace-name "$name"
    fi
  fi
  unpersist_workspace "$name"

  # niri keeps an empty workspace while focused — leave it so it is reaped
  other_idx=$(workspaces_json | jq -r --argjson id "${ws_id:-0}" '
    [.[] | select(.id != $id)] | sort_by(.idx) | first | .idx // empty
  ')
  if [[ -n ${other_idx:-} ]]; then
    niri msg action focus-workspace "$other_idx"
  else
    niri msg action focus-workspace-up || niri msg action focus-workspace-down || true
  fi

  notify "Deleted «$name»"
}

# Lines like: "1  pg_probackup3" or "2  (unnamed)" — stdout is idx\told_name_or_empty
list_workspace_picks() {
  workspaces_json | jq -r '
    sort_by(.idx)[] |
    (if .name != null then .name
     elif .active_window_id != null then "(unnamed)"
     else "(empty)" end) as $label
    | "\(.idx)  \($label)"
  '
}

pick_workspace_line() {
  local prompt=$1 line
  line=$(list_workspace_picks | "${FUZZEL[@]}" --prompt "$prompt" || true)
  [[ -n ${line:-} ]] || return 1
  printf '%s\n' "$line"
}

# From "1  name" → idx + optional real name (empty if unnamed/empty)
parse_workspace_pick() {
  local line=$1
  local idx label
  idx=$(printf '%s\n' "$line" | awk '{print $1}')
  label=$(printf '%s\n' "$line" | sed -E 's/^[0-9]+[[:space:]]+//')
  [[ $idx =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$idx"
  if [[ $label == '(unnamed)' || $label == '(empty)' ]]; then
    printf '\n'
  else
    printf '%s\n' "$label"
  fi
}

list_named_picks() {
  {
    list_presets | while IFS= read -r p; do
      [[ -n $p ]] || continue
      preset_is_open "$p" && echo "$p"
    done
    workspaces_json | jq -r '.[] | select(.name != null) | .name'
  } | awk 'NF && !seen[$0]++'
}

clear_workspace_name() {
  local name=$1
  niri msg action unset-workspace-name "$name"
  unpersist_workspace "$name"
  notify "Cleared «$name»"
}

rename_workspace() {
  local idx=$1 old_name=$2 new_name=$3
  if [[ -n $old_name ]]; then
    niri msg action set-workspace-name --workspace "$old_name" "$new_name"
    unpersist_workspace "$old_name"
  else
    niri msg action set-workspace-name --workspace "$idx" "$new_name"
  fi
  persist_workspace "$new_name"
  if [[ -n $old_name ]]; then
    notify "Renamed «$old_name» → «$new_name»"
  else
    notify "Named $idx → «$new_name»"
  fi
}

build_menu() {
  {
    echo "+ Empty named…"
    list_presets | while IFS= read -r p; do
      [[ -n $p ]] || continue
      if preset_is_open "$p"; then
        echo "● $p"
      else
        echo "+ $p"
      fi
    done
    echo "────────"
    workspaces_json | jq -r '
      sort_by(.idx)[] |
      (if .is_focused then "▶" elif .is_active then "○" else " " end) as $m
      | if .name != null then
          "\($m) \(.idx)  \(.name)"
        elif .active_window_id != null then
          "\($m) \(.idx)  (unnamed)"
        else
          "\($m) \(.idx)  (empty)"
        end
    '
    echo "✎ Rename…"
    echo "○ Clear name…"
    echo "× Delete…"
  }
}

prompt_name() {
  local prompt=$1 name
  name=$(fuzzel --dmenu --prompt-only "${prompt} " --width 40 || true)
  name=$(printf '%s' "$name" | tr -d '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
  [[ -n $name ]] || return 1
  if [[ $name == *\"* ]]; then
    notify "Invalid name"
    return 1
  fi
  printf '%s\n' "$name"
}

choice=$(build_menu | "${FUZZEL[@]}" --prompt "Workspace › " || true)
[[ -n ${choice:-} ]] || exit 0

case $choice in
  '────────')
    exit 0
    ;;
  '+ Empty named…')
    name=$(prompt_name "Name:") || exit 0
    focus_empty_unnamed
    niri msg action set-workspace-name "$name"
    persist_workspace "$name"
    notify "Created «$name»"
    ;;
  '✎ Rename…')
    line=$(pick_workspace_line "Rename › ") || exit 0
    {
      read -r idx
      read -r old_name
    } < <(parse_workspace_pick "$line") || exit 1
    new_name=$(prompt_name "New name:") || exit 0
    if [[ -n $old_name && $old_name == "$new_name" ]]; then
      notify "Same name"
      exit 0
    fi
    if workspaces_json | jq -e --arg n "$new_name" 'any(.name == $n)' >/dev/null; then
      notify "«$new_name» already exists"
      exit 1
    fi
    rename_workspace "$idx" "$old_name" "$new_name"
    ;;
  '○ Clear name…')
    named=$(list_named_picks | "${FUZZEL[@]}" --prompt "Clear name › " || true)
    [[ -n ${named:-} ]] || exit 0
    clear_workspace_name "$named"
    ;;
  '× Delete…')
    named=$(list_named_picks | "${FUZZEL[@]}" --prompt "Delete › " || true)
    [[ -n ${named:-} ]] || exit 0
    delete_workspace_by_name "$named"
    ;;
  ●\ *|+\ *)
    create_from_preset "${choice#* }"
    ;;
  *)
    idx=$(printf '%s\n' "$choice" | awk '{print $2}')
    [[ $idx =~ ^[0-9]+$ ]] || exit 1
    niri msg action focus-workspace "$idx"
    ;;
esac
