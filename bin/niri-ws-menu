#!/usr/bin/env bash
# Named workspaces + presets from ~/.config/niri/ws-presets.kdl
set -euo pipefail

FUZZEL=(fuzzel --dmenu --width 52 --lines 16 --no-icons)
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/niri"
WORKSPACES="$CONFIG_DIR/workspaces.kdl"
PRESETS="$CONFIG_DIR/ws-presets.kdl"

notify() {
  command -v notify-send >/dev/null && notify-send -a niri-ws "Workspaces" "$1" || true
}

workspaces_json() {
  niri msg --json workspaces
}

expand_path() {
  local p=$1
  if [[ $p == ~* ]]; then
    p="${p/#\~/$HOME}"
  fi
  printf '%s\n' "$p"
}

# List preset names from ws-presets.kdl
list_presets() {
  [[ -f $PRESETS ]] || return 0
  sed -nE 's/^[[:space:]]*preset[[:space:]]+"([^"]+)".*/\1/p' "$PRESETS"
}

# Extract body of preset "name" { ... } (non-nested)
preset_body() {
  local name=$1
  [[ -f $PRESETS ]] || return 1
  awk -v want="$name" '
    $0 ~ "^[[:space:]]*preset[[:space:]]+\"" want "\"" {
      grab=1
      next
    }
    grab {
      if ($0 ~ /^[[:space:]]*}/) exit
      print
    }
  ' "$PRESETS"
}

preset_cwd() {
  local name=$1 line val
  while IFS= read -r line; do
    if [[ $line =~ ^[[:space:]]*cwd[[:space:]]+\"([^\"]+)\" ]]; then
      expand_path "${BASH_REMATCH[1]}"
      return 0
    fi
  done < <(preset_body "$name")
  return 1
}

# Print spawn lines as NUL-separated argv arrays encoded: cmd\targ\targ\n
preset_spawns() {
  local name=$1 cwd="" line
  cwd=$(preset_cwd "$name" || true)

  while IFS= read -r line; do
    [[ $line =~ ^[[:space:]]*spawn[[:space:]] ]] || continue
    # collect "..." tokens
    local -a args=()
    local rest=$line
    while [[ $rest =~ \"([^\"]*)\"(.*) ]]; do
      args+=("${BASH_REMATCH[1]}")
      rest=${BASH_REMATCH[2]}
    done
    ((${#args[@]} > 0)) || continue

    # If only the command given and cwd set — sensible defaults
    if ((${#args[@]} == 1)) && [[ -n $cwd ]]; then
      case ${args[0]} in
        ghostty|kitty|alacritty|wezterm|foot)
          args+=("--working-directory=$cwd")
          ;;
        code|code-insiders|cursor|codium|emacs|nvim|vim|helix|zed)
          args+=("$cwd")
          ;;
        *)
          ;;
      esac
    fi

    local i
    printf '%s' "${args[0]}"
    for ((i = 1; i < ${#args[@]}; i++)); do
      printf '\t%s' "${args[i]}"
    done
    printf '\n'
  done < <(preset_body "$name")
}

persist_workspace() {
  local name=$1
  mkdir -p "$CONFIG_DIR"
  touch "$WORKSPACES"
  if grep -qE "^workspace \"$name\"( |\$|\{)" "$WORKSPACES"; then
    return 0
  fi
  printf 'workspace "%s"\n' "$name" >>"$WORKSPACES"
}

unpersist_workspace() {
  local name=$1
  [[ -f $WORKSPACES ]] || return 0
  sed -i -E "/^workspace \"$name\"( |\$|\{)/d" "$WORKSPACES"
}

focus_empty_unnamed() {
  local idx
  idx=$(workspaces_json | jq -r '
    [.[] | select(.name == null and .active_window_id == null)]
    | last
    | .idx // empty
  ')
  if [[ -n ${idx:-} ]]; then
    niri msg action focus-workspace "$idx"
    return 0
  fi
  idx=$(workspaces_json | jq -r '
    [.[] | select(.is_focused or .is_active)] | first | .output as $o
    | [.[] | select(.output == $o)] | last | .idx
  ')
  niri msg action focus-workspace "$idx"
}

ensure_named_workspace() {
  local name=$1 exists
  exists=$(workspaces_json | jq -r --arg n "$name" '.[] | select(.name == $n) | .name' | head -n1)
  if [[ -z ${exists:-} ]]; then
    focus_empty_unnamed
    niri msg action set-workspace-name "$name"
  fi
  persist_workspace "$name"
  niri msg action focus-workspace "$name"
}

launch_preset_apps() {
  local name=$1 line
  local -a args
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    IFS=$'\t' read -r -a args <<<"$line"
    "${args[@]}" &
  done < <(preset_spawns "$name")
}

preset_is_open() {
  local name=$1 cwd ws_id
  if workspaces_json | jq -e --arg n "$name" 'any(.name == $n)' >/dev/null; then
    return 0
  fi
  cwd=$(preset_cwd "$name" || true)
  [[ -n ${cwd:-} ]] || return 1
  ws_id=$(niri msg --json windows | jq -r --arg cwd "$cwd" --arg base "$(basename "$cwd")" '
    [.[] | select(
      (.title // "" | contains($cwd))
      or (.title // "" | contains($base))
    )] | first | .workspace_id // empty
  ')
  [[ -n ${ws_id:-} ]]
}

create_from_preset() {
  local name=$1
  if preset_is_open "$name"; then
    # already running — just focus, don't spawn again
    if workspaces_json | jq -e --arg n "$name" 'any(.name == $n)' >/dev/null; then
      niri msg action focus-workspace "$name"
    else
      local cwd wid
      cwd=$(preset_cwd "$name")
      wid=$(niri msg --json windows | jq -r --arg cwd "$cwd" --arg base "$(basename "$cwd")" '
        [.[] | select(
          (.title // "" | contains($cwd))
          or (.title // "" | contains($base))
        )] | first | .id // empty
      ')
      [[ -n ${wid:-} ]] && niri msg action focus-window --id "$wid"
    fi
    notify "Focus «$name»"
    return 0
  fi
  ensure_named_workspace "$name"
  sleep 0.05
  launch_preset_apps "$name"
  notify "Preset «$name»"
}

close_windows_on_workspace() {
  local ws_id=$1 wid
  while true; do
    wid=$(niri msg --json windows | jq -r --argjson id "$ws_id" '
      [.[] | select(.workspace_id == $id)] | first | .id // empty
    ')
    [[ -n ${wid:-} ]] || break
    niri msg action close-window --id "$wid" || break
    sleep 0.05
  done
}

delete_workspace_by_name() {
  local name=$1
  local ws_id cwd other_idx
  ws_id=$(workspaces_json | jq -r --arg n "$name" '
    .[] | select(.name == $n) | .id
  ' | head -n1)

  if [[ -z ${ws_id:-} ]]; then
    cwd=$(preset_cwd "$name" || true)
    if [[ -n ${cwd:-} ]]; then
      ws_id=$(niri msg --json windows | jq -r --arg cwd "$cwd" --arg base "$(basename "$cwd")" '
        [.[] | select(
          (.title // "" | contains($cwd))
          or (.title // "" | contains($base))
        )] | first | .workspace_id // empty
      ')
    fi
  fi

  if [[ -n ${ws_id:-} ]]; then
    local wid
    wid=$(niri msg --json windows | jq -r --argjson id "$ws_id" '
      [.[] | select(.workspace_id == $id)] | first | .id // empty
    ')
    if [[ -n ${wid:-} ]]; then
      niri msg action focus-window --id "$wid"
    elif [[ -n $name ]]; then
      niri msg action focus-workspace "$name" || true
    fi
    close_windows_on_workspace "$ws_id"
    if workspaces_json | jq -e --arg n "$name" 'any(.name == $n)' >/dev/null; then
      niri msg action unset-workspace-name
    fi
  fi
  unpersist_workspace "$name"

  # niri keeps an empty workspace while focused — leave it so it is reaped
  other_idx=$(workspaces_json | jq -r --argjson id "${ws_id:-0}" '
    [.[] | select(.id != $id)] | sort_by(.idx) | first | .idx // empty
  ')
  if [[ -n ${other_idx:-} ]]; then
    niri msg action focus-workspace "$other_idx"
  else
    niri msg action focus-workspace-up || niri msg action focus-workspace-down || true
  fi

  notify "Deleted «$name»"
}

build_menu() {
  {
    echo "+ Empty named…"
    list_presets | while IFS= read -r p; do
      [[ -n $p ]] || continue
      if preset_is_open "$p"; then
        echo "● $p"
      else
        echo "+ $p"
      fi
    done
    echo "────────"
    workspaces_json | jq -r '
      sort_by(.idx)[] |
      (if .is_focused then "▶" elif .is_active then "○" else " " end) as $m
      | if .name != null then
          "\($m) \(.idx)  \(.name)"
        elif .active_window_id != null then
          "\($m) \(.idx)  (unnamed)"
        else
          "\($m) \(.idx)  (empty)"
        end
    '
    echo "× Delete…"
  }
}

prompt_name() {
  local prompt=$1 name
  name=$(fuzzel --dmenu --prompt-only "${prompt} " --width 40 || true)
  name=$(printf '%s' "$name" | tr -d '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
  [[ -n $name ]] || return 1
  if [[ $name == *\"* ]]; then
    notify "Invalid name"
    return 1
  fi
  printf '%s\n' "$name"
}

choice=$(build_menu | "${FUZZEL[@]}" --prompt "Workspace › " || true)
[[ -n ${choice:-} ]] || exit 0

case $choice in
  '────────')
    exit 0
    ;;
  '+ Empty named…')
    name=$(prompt_name "Name:") || exit 0
    focus_empty_unnamed
    niri msg action set-workspace-name "$name"
    persist_workspace "$name"
    notify "Created «$name»"
    ;;
  '× Delete…')
    named=$(
      {
        list_presets | while IFS= read -r p; do
          [[ -n $p ]] || continue
          preset_is_open "$p" && echo "$p"
        done
        workspaces_json | jq -r '.[] | select(.name != null) | .name'
      } | awk 'NF && !seen[$0]++' | "${FUZZEL[@]}" --prompt "Delete › " || true
    )
    [[ -n ${named:-} ]] || exit 0
    delete_workspace_by_name "$named"
    ;;
  ●\ *|+\ *)
    create_from_preset "${choice#* }"
    ;;
  *)
    idx=$(printf '%s\n' "$choice" | awk '{print $2}')
    [[ $idx =~ ^[0-9]+$ ]] || exit 1
    niri msg action focus-workspace "$idx"
    ;;
esac
