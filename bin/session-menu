#!/usr/bin/env bash
set -euo pipefail

choice="$(
  printf '%s\n' \
    'Lock' \
    'Logout' \
    'Reboot' \
    'Shutdown' \
    'Cancel' \
  | fuzzel --dmenu --prompt 'Session: ' --lines 5
)"

case "$choice" in
  Lock)     exec swaylock -f ;;
  Logout)   exec niri msg action quit ;;
  Reboot)   exec systemctl reboot ;;
  Shutdown) exec systemctl poweroff ;;
  *)        exit 0 ;;
esac
