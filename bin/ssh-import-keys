#!/usr/bin/env bash
set -euo pipefail
[[ $# -ge 1 ]] || { echo "usage: ssh-import-keys [--clear] <path>..." >&2; exit 1; }

clear=0; paths=()
for a in "$@"; do
  case $a in --clear) clear=1 ;; *) paths+=("$a") ;; esac
done
[[ ${#paths[@]} -ge 1 ]] || exit 1

r=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
[[ -S ${SSH_AUTH_SOCK:-} ]] || {
  for SSH_AUTH_SOCK in "$r/ssh-agent.socket" "$r/openssh_agent"; do [[ -S $SSH_AUTH_SOCK ]] && break; done
}
export SSH_AUTH_SOCK
[[ -S $SSH_AUTH_SOCK ]] || { echo "ssh-import-keys: no agent socket" >&2; exit 1; }
[[ $clear -eq 1 ]] && ssh-add -D 2>/dev/null || true

mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
copied=()

iskey() {
  local l; [[ -f $1 && -r $1 ]] || return 1
  case ${1##*/} in *.pub|authorized_keys|known_hosts*|config|*.ppk) return 1 ;; esac
  IFS= read -r l <"$1" || return 1
  [[ $l == *"PRIVATE KEY"* ]]
}

cpkey() {
  local s=$1 d="$HOME/.ssh/${1##*/}"
  cp -f "$s" "$d" && chmod 600 "$d"
  [[ -f $s.pub ]] && cp -f "$s.pub" "$d.pub" && chmod 644 "$d.pub"
  echo "copy: $d"; copied+=("$d")
}

for p in "${paths[@]}"; do
  if [[ -f $p ]]; then iskey "$p" && cpkey "$p" || echo "skip: $p" >&2
  elif [[ -d $p ]]; then
    shopt -s nullglob
    for f in "$p"/*; do [[ -f $f ]] && iskey "$f" && cpkey "$f"; done
    shopt -u nullglob
  else echo "error: $p" >&2; exit 1
  fi
done

[[ ${#copied[@]} -eq 0 ]] && exit 0
mapfile -t xs < <(printf '%s\n' "${copied[@]}" | shuf)
for f in "${xs[@]}"; do echo "add: $f"; ssh-add -- "$f"; done
