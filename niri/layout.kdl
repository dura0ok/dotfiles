layout {
    gaps 12

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 3
        active-color "#7eb8da"
        inactive-color "#3a3f47"
    }

    border {
        off
    }

    shadow {
        on
        softness 40
        spread 4
        offset x=0 y=8
        color "#00000088"
    }

    struts {}
}
